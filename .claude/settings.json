{
  "permissions": {
    "allow": [
      "Edit(progress/**)",
      "Write(progress/**)",
      "Edit(lessons/**)",
      "Write(lessons/**)",
      "Edit(labs/**)",
      "Write(labs/**)",
      "Edit(vivas/**)",
      "Write(vivas/**)",
      "Edit(reviews/**)",
      "Write(reviews/**)",
      "Edit(reference/**)",
      "Write(reference/**)",
      "Edit(README.md)",
      "Bash(date:*)",
      "Bash(tools/run.sh:*)",
      "Bash(python3 tools/gen_tracker.py:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh" }
        ]
      }
    ]
  }
}
